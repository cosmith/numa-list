{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://numa.cosmith.fr/data.schema.json",
  "title": "Archive des startups Le Camping / NUMA Paris",
  "description": "Convention : un champ non documenté est absent, jamais null. Les compteurs et regroupements par saison sont calculés côté client.",
  "type": "object",
  "required": ["schemaVersion", "dataset", "startups"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "dataset": {
      "type": "object",
      "required": ["title", "scope", "generatedAt", "statusAsOf", "language"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "scope": { "type": "string" },
        "generatedAt": { "$ref": "#/$defs/date" },
        "statusAsOf": { "$ref": "#/$defs/date" },
        "language": { "const": "fr" },
        "notes": { "type": "array", "items": { "type": "string" } },
        "factCheckedAt": { "$ref": "#/$defs/date" },
        "factCheckMethodology": { "type": "string" },
        "factCheckAuditFiles": { "type": "array", "items": { "type": "string" } }
      }
    },
    "startups": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/startup" }
    }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "url": { "type": "string", "pattern": "^https?://" },
    "startupId": { "type": "string", "pattern": "^s[1-9][0-9]?-[a-z0-9-]+$" },
    "source": {
      "type": "object",
      "required": ["url", "supports"],
      "additionalProperties": false,
      "properties": {
        "url": { "$ref": "#/$defs/url" },
        "title": { "type": "string" },
        "publisher": { "type": "string" },
        "sourceType": { "type": "string" },
        "accessedAt": { "$ref": "#/$defs/date" },
        "supports": {
          "description": "Affirmations que cette source justifie.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["cohort", "status", "founders", "identity"] }
        }
      }
    },
    "founder": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "linkedin": { "$ref": "#/$defs/url" }
      }
    },
    "startup": {
      "type": "object",
      "required": [
        "id", "season", "name", "formerNamesOrPivots", "founders",
        "foundersPubliclyIdentified", "status", "statusAsOf", "statusDetails",
        "sources", "confidence", "seenInPhoto", "factCheck"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/startupId" },
        "season": { "type": "integer", "minimum": 1, "maximum": 99 },
        "name": { "type": "string", "minLength": 1 },
        "formerNamesOrPivots": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "founders": { "type": "array", "items": { "$ref": "#/$defs/founder" } },
        "foundersPubliclyIdentified": { "type": "boolean" },
        "status": { "enum": ["active", "exit", "stopped"] },
        "statusAsOf": {
          "description": "Date de dernière vérification du statut de cette fiche ; peut diverger de dataset.statusAsOf au fil des corrections.",
          "$ref": "#/$defs/date"
        },
        "statusDetails": { "type": "string", "minLength": 1 },
        "activityDescription": { "type": "string" },
        "acquirer": { "type": "string", "minLength": 1 },
        "website": { "$ref": "#/$defs/url" },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/source" }
        },
        "confidence": { "enum": ["high", "medium", "low"] },
        "seenInPhoto": {
          "description": "Présence identifiée sur la photo de la promotion ; information rarement vérifiable par une source publique.",
          "type": "boolean"
        },
        "notes": { "type": "string" },
        "factCheck": {
          "type": "object",
          "required": ["verdict", "checkedAt", "fields"],
          "additionalProperties": false,
          "properties": {
            "verdict": { "enum": ["verified", "corrected", "unverifiable"] },
            "checkedAt": { "$ref": "#/$defs/date" },
            "fields": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {
                "enum": [
                  "cohort", "formerNamesOrPivots", "founders", "identity",
                  "name", "season", "seenInPhoto", "status", "statusDetails",
                  "website"
                ]
              },
              "additionalProperties": {
                "enum": [
                  "verified", "corrected", "unverifiable",
                  "conflicting", "verified_absent", "partially_verified"
                ]
              }
            },
            "evidenceCount": { "type": "integer", "minimum": 0 },
            "auditFile": { "type": "string" }
          }
        }
      }
    }
  }
}
