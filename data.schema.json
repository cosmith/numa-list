{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://numa.cosmith.fr/data.schema.json",
  "title": "Archive des startups Le Camping / NUMA Paris",
  "type": "object",
  "required": ["schemaVersion", "dataset", "summary", "seasons", "startups"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "dataset": {
      "type": "object",
      "required": ["title", "scope", "generatedAt", "statusAsOf", "language"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "scope": { "type": "string" },
        "generatedAt": { "$ref": "#/$defs/date" },
        "statusAsOf": { "$ref": "#/$defs/date" },
        "language": { "const": "fr" },
        "notes": { "type": "array", "items": { "type": "string" } },
        "factCheckedAt": { "$ref": "#/$defs/date" },
        "factCheckMethodology": { "type": "string" },
        "factCheckAuditFiles": { "type": "array", "items": { "type": "string" } }
      }
    },
    "summary": {
      "type": "object",
      "required": ["startupCount", "statusCounts"],
      "properties": {
        "startupCount": { "type": "integer", "minimum": 1 },
        "founderTeamsIdentified": { "type": "integer", "minimum": 0 },
        "statusCounts": {
          "type": "object",
          "required": ["active", "exit", "stopped"],
          "additionalProperties": false,
          "properties": {
            "active": { "type": "integer", "minimum": 0 },
            "exit": { "type": "integer", "minimum": 0 },
            "stopped": { "type": "integer", "minimum": 0 }
          }
        },
        "confidenceCounts": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "factCheckVerdictCounts": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "seasons": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "required": ["number", "startupCount", "startupIds"],
        "additionalProperties": false,
        "properties": {
          "number": { "type": "integer", "minimum": 1, "maximum": 9 },
          "startupCount": { "type": "integer", "minimum": 1 },
          "startupIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/startupId" }
          }
        }
      }
    },
    "startups": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/startup" }
    }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "url": { "type": "string", "pattern": "^https?://" },
    "startupId": { "type": "string", "pattern": "^s[1-9]-[a-z0-9-]+$" },
    "sourceRef": {
      "oneOf": [
        { "$ref": "#/$defs/url" },
        {
          "type": "object",
          "required": ["url"],
          "additionalProperties": false,
          "properties": {
            "url": { "$ref": "#/$defs/url" },
            "title": { "type": "string" },
            "publisher": { "type": "string" },
            "sourceType": { "type": "string" },
            "accessedAt": { "$ref": "#/$defs/date" },
            "supports": { "type": "array", "items": { "type": "string" } }
          }
        }
      ]
    },
    "startup": {
      "type": "object",
      "required": [
        "id", "season", "name", "formerNamesOrPivots", "founders",
        "foundersPubliclyIdentified", "status", "statusLabel", "statusAsOf",
        "statusDetails", "website", "sources", "confidence", "confidenceLabel",
        "seenInPhoto", "notes", "factCheck"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/startupId" },
        "season": { "type": "integer", "minimum": 1, "maximum": 9 },
        "name": { "type": "string", "minLength": 1 },
        "formerNamesOrPivots": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "founders": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "foundersPubliclyIdentified": { "type": "boolean" },
        "status": { "enum": ["active", "exit", "stopped"] },
        "statusLabel": { "enum": ["En activité", "Exit", "Stoppé"] },
        "statusAsOf": { "$ref": "#/$defs/date" },
        "statusDetails": { "type": "string", "minLength": 1 },
        "activityDescription": { "type": "string" },
        "acquirer": { "type": ["string", "null"] },
        "website": {
          "oneOf": [{ "$ref": "#/$defs/url" }, { "type": "null" }]
        },
        "sources": {
          "type": "object",
          "required": ["cohort", "foundersOrStatus"],
          "additionalProperties": false,
          "properties": {
            "cohort": { "$ref": "#/$defs/sourceRef" },
            "foundersOrStatus": { "$ref": "#/$defs/sourceRef" }
          }
        },
        "confidence": { "enum": ["high", "medium", "low"] },
        "confidenceLabel": { "enum": ["Élevée", "Moyenne", "Faible"] },
        "seenInPhoto": { "type": "boolean" },
        "notes": { "type": ["string", "null"] },
        "founderProfiles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "linkedin"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "linkedin": { "$ref": "#/$defs/url" }
            }
          }
        },
        "factCheck": {
          "type": "object",
          "required": ["verdict", "checkedAt", "fields"],
          "additionalProperties": false,
          "properties": {
            "verdict": { "enum": ["verified", "corrected", "unverifiable"] },
            "checkedAt": { "$ref": "#/$defs/date" },
            "fields": {
              "type": "object",
              "additionalProperties": {
                "enum": [
                  "verified", "corrected", "unverifiable",
                  "conflicting", "verified_absent", "partially_verified"
                ]
              }
            },
            "evidenceCount": { "type": "integer", "minimum": 0 },
            "auditFile": { "type": "string" }
          }
        }
      }
    }
  }
}
